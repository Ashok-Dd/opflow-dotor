{
  "name": "opflow-doctor-web",
  "version": "0.1.0",
  "private": true,
  "description": "OPflow for Doctors: the doctor's OPD console on the web. Talks only to the OPflow API's doctor routes, server-side.",
  "scripts": {
    "sync:te": "node scripts/sync-te.mjs",
    "prebuild": "node scripts/sync-te.mjs",
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
