# OPflow for Doctors (doctor website). The site holds no API secrets except DOCTOR_WEB_KEY: each doctor's own
# session lives in httpOnly cookies, and every API call is made from this server (never from the browser).

# The OPflow API, called from this server.
DOCTOR_API_BASE_URL=http://localhost:3000

# The same secret as DOCTOR_WEB_KEY on the API (at least 32 characters). With it, the API sees each doctor's real
# browser address, so sign-in limits and the "signed-in devices" list are per doctor, not per this server.
DOCTOR_WEB_KEY=

# Where browsers open the live-line connection (the API's public address; same as DOCTOR_API_BASE_URL in production).
NEXT_PUBLIC_LIVE_URL=http://localhost:3000
